@import url("Common.uss");

.root { flex-grow: 1; background-color: #0B0E18; }
.spacer { flex-grow: 1; }
.row { flex-direction: row; align-items: center; }

/* ================= Giriş ================= */
.intro {
    position: absolute; left: 0; right: 0; top: 0; bottom: 0;
    align-items: center; justify-content: center;
    opacity: 1; scale: 1 1;
    transition-property: opacity, scale;
    transition-duration: 0.6s, 0.8s;
    transition-timing-function: ease-in, ease-in;
}
.intro--out { opacity: 0; scale: 1.15 1.15; }
.intro-studio {
    color: var(--ink-dim); font-size: 18px; letter-spacing: 8px; margin-bottom: 18px;
    opacity: 0; translate: 0 10px;
    transition-property: opacity, translate; transition-duration: 0.8s, 0.8s;
}
.intro .logo {
    opacity: 0; scale: 0.4 0.4; translate: 0 -120px; rotate: 8deg;
    transition-property: opacity, scale, translate, rotate;
    transition-duration: 0.35s, 0.9s, 0.9s, 0.9s;
    transition-timing-function: ease-out, ease-out-elastic, ease-out-bounce, ease-out-back;
}
.tagline {
    color: var(--ink); font-size: 24px; -unity-font-style: italic; margin-top: 6px;
    opacity: 0; transition-property: opacity; transition-duration: 0.8s;
}
.press-any {
    margin-top: 70px; color: var(--accent); font-size: 18px; letter-spacing: 6px; -unity-font-style: bold;
    opacity: 0; transition-property: opacity; transition-duration: 0.5s;
}
.intro .is-in { opacity: 1; scale: 1 1; translate: 0 0; rotate: 0deg; }
.intro .press-any.press-any--dim { opacity: 0.25; }

/* ================= Menü ================= */
.menu {
    position: absolute; left: 0; right: 0; top: 0; bottom: 0;
    flex-direction: row; justify-content: space-between;
    padding: 70px 110px 70px 110px;
    opacity: 1; translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: 0.6s, 0.7s;
    transition-timing-function: ease-out, ease-out-back;
}
.menu--hidden { opacity: 0; translate: -60px 0; }
.menu--gone { display: none; }
.menu__left { width: 560px; justify-content: flex-start; }
.menu__left .logo { margin-bottom: 30px; }
.menu__right { justify-content: center; align-items: flex-end; }

.page {
    opacity: 1; translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: 0.25s, 0.3s;
    transition-timing-function: ease-out, ease-out-back;
}
.page--hidden { display: none; }
.page--enter { opacity: 0; translate: -30px 0; }
.page--scroll { flex-grow: 1; max-height: 720px; }
.page--scroll .unity-scroll-view__content-container { padding-right: 14px; }

/* Büyük seçim kutuları */
.tile {
    height: 96px; margin: 7px 0; padding: 14px 26px;
    border-width: 0; border-left-width: 5px; border-color: transparent; border-radius: 8px;
    background-color: rgba(255, 255, 255, 0.07);
    align-items: flex-start; justify-content: center;
    translate: 0 0;
    transition-property: background-color, translate, border-color, scale;
    transition-duration: 0.15s, 0.18s, 0.15s, 0.1s;
    transition-timing-function: ease-out, ease-out-back, ease-out, ease-out;
}
.tile:hover { background-color: rgba(255, 255, 255, 0.13); border-color: var(--accent); translate: 12px 0; }
.tile:active { scale: 0.98 0.98; }
.tile__title { color: var(--ink); font-size: 26px; -unity-font-style: bold; letter-spacing: 3px; margin: 0; padding: 0; }
.tile__desc { color: var(--ink-dim); font-size: 15px; margin: 4px 0 0 0; padding: 0; white-space: normal; }
.tile--primary { background-color: var(--accent); }
.tile--primary:hover { background-color: #FF955C; border-color: #FFFFFF; }
.tile--primary .tile__title { color: #1A0E06; }
.tile--primary .tile__desc { color: rgba(26, 14, 6, 0.75); }

.section-label { color: var(--accent); font-size: 13px; letter-spacing: 5px; -unity-font-style: bold; margin: 18px 0 4px 2px; }
.menu-btn--grow { flex-grow: 1; }
.menu-btn--small { height: 44px; font-size: 17px; }
.menu-btn--center { -unity-text-align: middle-center; min-width: 220px; margin: 0 6px; }
.field--grow { flex-grow: 1; min-width: 0; }
.field--compact { min-width: 300px; margin: 6px 0 0 0; }
.small-btn { height: 44px; margin-left: 8px; padding: 0 16px; -unity-font-style: bold; }
.small-btn--accent { background-color: var(--accent); color: #1A0E06; }
.small-btn--accent:hover { background-color: #FF955C; }

/* Sağ paneller */
.panel { align-items: flex-end; }
.panel--hidden { display: none; }
.card--browser { width: 520px; height: 600px; }
.tabs { flex-direction: row; align-items: center; margin-bottom: 10px; }
.tab {
    background-color: transparent; border-width: 0; border-bottom-width: 3px; border-color: transparent;
    color: var(--ink-dim); font-size: 15px; -unity-font-style: bold; letter-spacing: 3px;
    padding: 6px 10px; margin-right: 8px; border-radius: 0;
}
.tab:hover { color: var(--ink); }
.tab--active { color: var(--ink); border-color: var(--accent); }
.browser-list { flex-grow: 1; }
.browser-empty { -unity-text-align: middle-center; max-width: none; margin-top: 30px; }

.entry {
    flex-direction: row; align-items: center;
    padding: 8px 10px; margin-bottom: 6px; border-radius: 8px;
    background-color: rgba(255, 255, 255, 0.05);
}
.entry:hover { background-color: rgba(255, 255, 255, 0.09); }
.entry__avatar { width: 40px; height: 40px; border-radius: 6px; margin-right: 12px; background-color: rgba(255, 255, 255, 0.1); -unity-background-scale-mode: scale-and-crop; }
.entry__text { flex-grow: 1; }
.entry__name { color: var(--ink); font-size: 17px; -unity-font-style: bold; }
.entry__sub { color: var(--ink-dim); font-size: 13px; }
.entry__sub--live { color: #7CE08F; }

/* Durum çubuğu */
.status-bar { position: absolute; left: 110px; right: 110px; bottom: 26px; flex-direction: row; align-items: center; }
.dot { width: 10px; height: 10px; border-radius: 5px; background-color: #888; margin-right: 10px; }
.dot--ok { background-color: #5BE37D; }
.dot--off { background-color: #FFB347; }
.status-text { color: var(--ink-dim); font-size: 15px; }
.status-text--right { position: absolute; right: 0; }

/* ================= Lobi ================= */
.lobby {
    position: absolute; left: 0; right: 0; top: 0; bottom: 0;
    padding: 70px 110px 60px 110px;
    background-color: rgba(8, 10, 18, 0.55);
    opacity: 1; translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: 0.35s, 0.45s;
    transition-timing-function: ease-out, ease-out-back;
}
.lobby--hidden { display: none; }
.lobby--enter { opacity: 0; translate: 0 30px; }
.lobby__header { flex-direction: row; align-items: flex-start; }
.lobby__title { color: var(--ink); font-size: 72px; -unity-font-style: bold; letter-spacing: 14px; }
.lobby__mode { color: var(--accent); font-size: 20px; -unity-font-style: bold; letter-spacing: 3px; margin-top: -6px; }
.lobby__info { align-items: flex-end; }
.code-row {
    flex-direction: row; align-items: center;
    background-color: rgba(10, 12, 22, 0.7); border-radius: 8px; padding: 8px 8px 8px 16px;
}
.code-row__label { color: var(--ink-dim); font-size: 15px; margin-right: 10px; }
.code-row__code { color: var(--ink); font-size: 20px; -unity-font-style: bold; letter-spacing: 2px; margin-right: 6px; }

.lobby__slots { flex-direction: row; justify-content: space-between; margin-top: 50px; flex-grow: 1; max-height: 420px; }
.slot {
    flex-grow: 1; flex-basis: 0; margin: 0 10px;
    border-radius: 14px; border-width: 2px; border-color: rgba(255, 255, 255, 0.08);
    background-color: rgba(18, 22, 38, 0.85);
    align-items: center; padding: 0 16px 20px 16px; overflow: hidden;
    translate: 0 0; scale: 1 1;
    transition-property: border-color, translate, scale;
    transition-duration: 0.2s, 0.3s, 0.3s;
    transition-timing-function: ease-out, ease-out-back, ease-out-back;
}
.slot--new { translate: 0 40px; scale: 0.9 0.9; }
.slot--empty { background-color: rgba(18, 22, 38, 0.35); justify-content: center; }
.slot--ready { border-color: #5BE37D; }
.slot__stripe { height: 8px; align-self: stretch; margin: 0 -16px 22px -16px; }
.slot__avatar {
    width: 120px; height: 120px; border-radius: 60px; margin-bottom: 16px;
    -unity-background-scale-mode: scale-and-crop;
    align-items: center; justify-content: center;
    border-width: 4px; border-color: rgba(255, 255, 255, 0.15);
}
.slot__initial { font-size: 54px; color: #1A0E06; -unity-font-style: bold; }
.slot__name { color: var(--ink); font-size: 22px; -unity-font-style: bold; -unity-text-align: middle-center; white-space: normal; }
.slot__badges { flex-direction: row; margin: 6px 0 10px 0; min-height: 24px; }
.badge { font-size: 12px; -unity-font-style: bold; letter-spacing: 2px; padding: 3px 9px; border-radius: 10px; margin: 0 3px; color: #1A0E06; background-color: var(--accent); }
.badge--you { background-color: rgba(255, 255, 255, 0.85); }
.slot__limbs { color: #FFD7BF; font-size: 15px; -unity-text-align: middle-center; white-space: normal; min-height: 40px; }
.slot__state { margin-top: 12px; font-size: 15px; -unity-font-style: bold; letter-spacing: 3px; color: var(--ink-dim); }
.slot__state--ready { color: #5BE37D; }
.slot__kick { margin-top: 12px; height: 30px; font-size: 13px; }
.slot__kick:hover { background-color: var(--danger); color: #FFFFFF; }
.slot__empty-title { color: var(--ink-dim); font-size: 20px; -unity-font-style: bold; }
.slot__empty-hint { color: rgba(244, 239, 230, 0.4); font-size: 14px; margin-top: 6px; }
.slot__plus { font-size: 60px; color: rgba(255, 255, 255, 0.15); }

.lobby__status { color: var(--ink-dim); font-size: 18px; -unity-text-align: middle-center; margin: 20px 0; }
.lobby__actions { flex-direction: row; align-items: center; }

/* ================= Modal ================= */
.modal {
    position: absolute; left: 0; right: 0; top: 0; bottom: 0;
    background-color: rgba(5, 6, 12, 0.72);
    align-items: center; justify-content: center;
}
.modal--hidden { display: none; }
.modal__card {
    background-color: #151A2B; border-radius: 12px; border-width: 1px; border-color: var(--panel-border);
    padding: 34px 44px; align-items: center; min-width: 500px; max-width: 680px;
}
.modal__title { color: var(--ink); font-size: 28px; -unity-font-style: bold; letter-spacing: 5px; margin-top: 14px; }
.modal__text { color: var(--ink-dim); font-size: 18px; white-space: normal; -unity-text-align: middle-center; margin: 10px 0 22px 0; }
.modal__buttons { flex-direction: row; }
.modal__btn { min-width: 200px; -unity-text-align: middle-center; margin: 0 6px; }
.spinner {
    width: 54px; height: 54px; border-radius: 27px; border-width: 5px;
    border-color: rgba(255, 255, 255, 0.12); border-top-color: var(--accent);
}
.spinner--hidden { display: none; }

/* ================= Bildirimler ================= */
.toast-stack { position: absolute; right: 30px; top: 30px; align-items: flex-end; }
.toast-item {
    background-color: rgba(15, 18, 30, 0.92); border-left-width: 4px; border-color: var(--accent);
    color: var(--ink); font-size: 17px; padding: 10px 18px; border-radius: 6px; margin-bottom: 8px;
    opacity: 1; translate: 0 0;
    transition-property: opacity, translate; transition-duration: 0.3s, 0.35s;
    transition-timing-function: ease-out, ease-out-back;
}
.toast-item--hidden { opacity: 0; translate: 40px 0; }
