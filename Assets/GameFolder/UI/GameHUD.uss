@import url("Common.uss");

.hud { flex-grow: 1; }

/* Oyuncu listesi */
.roster { position: absolute; left: 24px; top: 22px; }
.roster-item {
    flex-direction: row; align-items: center;
    background-color: rgba(255, 248, 238, 0.92);
    border-radius: 22px; border-bottom-width: 4px; border-color: #EAD7C1;
    padding: 5px 14px 5px 6px; margin-bottom: 8px;
}
.roster-item--local { background-color: var(--white); }
.roster-item__dot { width: 26px; height: 26px; border-radius: 13px; margin-right: 10px; border-width: 3px; border-color: var(--white); }
.roster-item__name { -unity-font-definition: url("Fonts/Baloo2-ExtraBold.ttf"); color: var(--ink); font-size: 19px; margin-right: 8px; padding-top: 3px; }
.limb-chip {
    -unity-font-definition: url("Fonts/Nunito-ExtraBold.ttf");
    font-size: 13px; color: var(--ink-soft);
    padding: 2px 10px; border-radius: 12px; margin-left: 4px;
    background-color: var(--cream-2);
}
.limb-chip--active { color: var(--white); background-color: var(--coral); }

/* Bildirim */
.toast {
    position: absolute; left: 0; right: 0; top: 96px;
    align-items: center;
    opacity: 0; translate: 0 -24px; scale: 0.85 0.85;
    transition-property: opacity, translate, scale;
    transition-duration: 0.25s, 0.4s, 0.4s;
    transition-timing-function: ease-out, ease-out-back, ease-out-back;
}
.toast--show { opacity: 1; translate: 0 0; scale: 1 1; }
.toast__text {
    -unity-font-definition: url("Fonts/Baloo2-ExtraBold.ttf");
    background-color: var(--cream);
    border-bottom-width: 6px; border-color: #EAD7C1;
    color: var(--ink); font-size: 30px;
    padding: 10px 30px 4px 30px; border-radius: 26px;
}

/* Zirve */
.summit {
    position: absolute; left: 0; right: 0; top: 0; bottom: 0;
    align-items: center; justify-content: center;
    opacity: 1; scale: 1 1; rotate: 0deg;
    transition-property: opacity, scale, rotate;
    transition-duration: 0.4s, 0.9s, 0.9s;
    transition-timing-function: ease-out, ease-out-elastic, ease-out-elastic;
}
.summit--hidden { opacity: 0; scale: 0.3 0.3; rotate: -12deg; }
.summit__title {
    -unity-font-definition: url("Fonts/Baloo2-ExtraBold.ttf");
    font-size: 170px; color: var(--sun);
    -unity-text-outline-width: 6px; -unity-text-outline-color: var(--ink);
    text-shadow: 0 10px 0 rgba(59, 47, 74, 0.35);
}
.summit__text {
    -unity-font-definition: url("Fonts/Baloo2-ExtraBold.ttf");
    font-size: 30px; color: var(--ink);
    background-color: var(--cream); border-radius: 22px; padding: 8px 24px 2px 24px; margin-top: -20px;
}

/* Kontroller */
.controls {
    -unity-font-definition: url("Fonts/Nunito-ExtraBold.ttf");
    position: absolute; bottom: 14px; left: 0; right: 0;
    -unity-text-align: middle-center;
    color: var(--ink); font-size: 15px;
    opacity: 1;
    transition-property: opacity;
    transition-duration: 1.2s;
}
.controls--faded { opacity: 0; }

/* Duraklat */
.pause {
    position: absolute; left: 0; right: 0; top: 0; bottom: 0;
    background-color: rgba(59, 47, 74, 0.4);
    align-items: center; justify-content: center;
}
.pause--hidden { display: none; }
.pause__card {
    background-color: var(--cream);
    border-radius: 34px; border-bottom-width: 9px; border-color: #EAD7C1;
    padding: 28px 36px 24px 36px;
    min-width: 470px;
}
.lobby-row {
    flex-direction: row; align-items: center; margin: 4px 0 12px 0;
    background-color: var(--white); border-radius: 16px; padding: 6px 6px 6px 14px;
}
.lobby-row__label { color: var(--ink-soft); font-size: 15px; margin-right: 8px; }
.lobby-row__code { -unity-font-definition: url("Fonts/Baloo2-ExtraBold.ttf"); color: var(--ink); font-size: 20px; flex-grow: 1; padding-top: 3px; }

/* Uzuv paneli */
.limb-panel {
    position: absolute; left: 0; right: 0; bottom: 44px;
    flex-direction: row; justify-content: center;
}
.limb-card {
    width: 160px; margin: 0 6px; padding: 8px 12px 8px 8px;
    border-radius: 22px; border-bottom-width: 5px; border-color: #EAD7C1;
    background-color: rgba(255, 248, 238, 0.92);
    flex-direction: row; align-items: center;
    translate: 0 0; scale: 1 1;
    transition-property: translate, scale, background-color;
    transition-duration: 0.18s, 0.25s, 0.15s;
    transition-timing-function: ease-out-back, ease-out-back, ease-out;
}
.limb-card--active { translate: 0 -10px; scale: 1.06 1.06; background-color: var(--white); border-color: var(--coral); }
.limb-card__key {
    -unity-font-definition: url("Fonts/Baloo2-ExtraBold.ttf");
    width: 38px; height: 38px; border-radius: 13px;
    background-color: var(--cream-2); color: var(--ink);
    font-size: 22px; -unity-text-align: middle-center; padding-top: 4px;
    margin-right: 10px;
}
.limb-card--active .limb-card__key { background-color: var(--coral); color: var(--white); }
.limb-card__name { -unity-font-definition: url("Fonts/Baloo2-ExtraBold.ttf"); color: var(--ink); font-size: 18px; }
.limb-card__state { -unity-font-definition: url("Fonts/Nunito-ExtraBold.ttf"); color: var(--ink-soft); font-size: 12px; letter-spacing: 1px; margin-top: -4px; }
.limb-card__state--grab { color: var(--mint-dark); }
.limb-card__state--fist { color: var(--sun-dark); }

/* Eğitim ipucu */
.tutorial {
    position: absolute; left: 0; right: 0; top: 150px;
    align-items: center;
    opacity: 0; translate: 0 10px;
    transition-property: opacity, translate; transition-duration: 0.4s, 0.4s;
}
.tutorial--show { opacity: 1; translate: 0 0; }
.tutorial__text {
    -unity-font-definition: url("Fonts/Nunito-ExtraBold.ttf");
    background-color: var(--sky); color: var(--white);
    border-bottom-width: 5px; border-color: var(--sky-dark);
    font-size: 21px; padding: 10px 26px; border-radius: 22px;
}
