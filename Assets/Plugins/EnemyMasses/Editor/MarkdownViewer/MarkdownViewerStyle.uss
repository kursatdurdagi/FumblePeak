/* Markdown Viewer Styles */

.markdown-container {
    padding: 10px;
    background-color: var(--unity-colors-window-background);
    border-radius: 4px;
    color: var(--unity-colors-default-text);
}

.markdown-header-1 {
    font-size: 24px;
    -unity-font-style: bold;
    color: var(--unity-colors-label-text-focus);
    margin-top: 10px;
    margin-bottom: 5px;
}

.markdown-header-2 {
    font-size: 20px;
    -unity-font-style: bold;
    color: var(--unity-colors-label-text-focus);
    margin-top: 8px;
    margin-bottom: 4px;
}

.markdown-header-3 {
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--unity-colors-label-text-focus);
    margin-top: 6px;
    margin-bottom: 3px;
}

.markdown-header-4 {
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--unity-colors-label-text-focus);
    margin-top: 4px;
    margin-bottom: 2px;
}

.markdown-paragraph {
    font-size: 12px;
    white-space: normal;
    margin-top: 2px;
    margin-bottom: 2px;
    color: var(--unity-colors-default-text);
}

.markdown-code-block {
    background-color: var(--unity-colors-inspector_titlebar-background);
    border-radius: 4px;
    padding: 8px;
    margin-top: 5px;
    margin-bottom: 5px;
    font-size: 11px;
    color: var(--unity-colors-default-text);
    white-space: pre-wrap;
}

.markdown-inline-code {
    background-color: var(--unity-colors-toolbar-background);
    border-radius: 2px;
    padding: 1px 4px;
    font-size: 11px;
    color: var(--unity-colors-default-text);
}

.markdown-code-language {
    font-size: 10px;
    -unity-font-style: italic;
    color: var(--unity-colors-label-text);
    margin-top: 4px;
    margin-bottom: 2px;
}

.markdown-blockquote {
    border-left-width: 3px;
    border-left-color: var(--unity-colors-toolbar-border);
    padding-left: 10px;
    margin-left: 5px;
    color: var(--unity-colors-label-text);
    -unity-font-style: italic;
}

.markdown-list-item {
    padding-left: 20px;
    margin-top: 1px;
    margin-bottom: 1px;
}

.markdown-link {
    color: var(--unity-colors-label-text-focus);
}

.markdown-horizontal-rule {
    height: 1px;
    background-color: var(--unity-colors-toolbar-border);
    margin-top: 10px;
    margin-bottom: 10px;
}

.markdown-table {
    margin-top: 6px;
    margin-bottom: 6px;
    border-width: 1px;
    border-color: var(--unity-colors-toolbar-border);
    border-radius: 3px;
}

.markdown-table-row {
    flex-direction: row;
}

.markdown-table-header-row {
    background-color: var(--unity-colors-inspector_titlebar-background);
}

.markdown-table-row-alt {
    background-color: var(--unity-colors-toolbar-background);
}

.markdown-table-header {
    font-size: 11px;
    -unity-font-style: bold;
    padding: 3px 5px;
    color: var(--unity-colors-default-text);
}

.markdown-table-cell {
    font-size: 11px;
    padding: 3px 5px;
    color: var(--unity-colors-default-text);
    white-space: normal;
}

.markdown-toolbar {
    flex-direction: row;
    justify-content: space-between;
    padding: 5px;
    background-color: var(--unity-colors-toolbar-background);
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-toolbar-border);
}

.markdown-toolbar-button {
    padding: 4px 12px;
    border-radius: 3px;
}
