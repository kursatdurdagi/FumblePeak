/* === Enemy Crowd Editor Stylesheet === */

/* === Header === */
.header {
    background-color: var(--unity-colors-toolbar-background);
    padding: 16px;
    border-bottom-width: 2px;
    border-bottom-color: var(--unity-colors-toolbar-border);
}

.header-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--unity-colors-default-text);
    -unity-text-align: middle-center;
    margin-bottom: 4px;
}

.header-subtitle {
    font-size: 13px;
    color: var(--unity-colors-label-text-focus);
    -unity-text-align: middle-center;
}

/* === Tab Bar === */
.tab-bar {
    flex-direction: row;
    background-color: var(--unity-colors-toolbar-background);
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-toolbar-border);
}

.tab-button {
    flex-grow: 1;
    padding: 12px;
    background-color: transparent;
    border-width: 0;
    border-bottom-width: 3px;
    border-bottom-color: transparent;
    color: var(--unity-colors-label-text);
    font-size: 13px;
    -unity-text-align: middle-center;
    transition-duration: 0.2s;
}

.tab-button:hover {
    background-color: var(--unity-colors-button-background-hover);
    color: var(--unity-colors-button-text-hover);
}

.tab-active {
    background-color: var(--unity-colors-button-background-pressed);
    border-bottom-color: var(--unity-colors-highlight-background);
    color: var(--unity-colors-button-text-pressed);
}

/* === Content Container === */
.content-container {
    flex-grow: 1;
}

.tab-content {
    padding: 12px;
}

/* === Sections === */
.section {
    margin-bottom: 12px;
}

Foldout {
    margin-bottom: 8px;
}

Foldout > .unity-foldout__toggle {
    background-color: var(--unity-colors-inspector_titlebar-background);
    border-radius: 4px;
    padding: 8px;
    margin-bottom: 4px;
}

Foldout > .unity-foldout__toggle:hover {
    background-color: var(--unity-colors-button-background-hover);
}

.config-description {
    font-size: 11px;
    color: var(--unity-colors-label-text-focus);
    margin-bottom: 8px;
    white-space: normal;
}

/* === Component Status === */
.component-status {
    padding: 12px;
    background-color: var(--unity-colors-inspector_titlebar-background);
    border-radius: 4px;
    margin-top: 8px;
    margin-bottom: 8px;
}

/* === Buttons === */
.primary-button {
    padding: 10px;
    background-color: var(--unity-colors-button-background);
    border-radius: 4px;
    border-width: 0;
    color: var(--unity-colors-button-text);
    font-size: 12px;
    -unity-font-style: bold;
    margin-top: 8px;
}

.primary-button:hover {
    background-color: var(--unity-colors-button-background-hover);
}

.primary-button:active {
    background-color: var(--unity-colors-button-background-pressed);
}

/* === Standard Elements === */
PropertyField {
    margin-top: 4px;
    margin-bottom: 4px;
}

.section-header {
    margin-top: 8px;
    margin-bottom: 4px;
    -unity-font-style: bold;
    color: var(--unity-colors-label-text);
}

HelpBox {
    margin-top: 6px;
    margin-bottom: 6px;
}

/* === Dropdown/Popup Fix === */
/* Ensure dropdowns render above other elements */
EnumField {
    overflow: visible;
}

EnumField > .unity-enum-field__input {
    overflow: visible;
}

PopupField {
    overflow: visible;
}

DropdownField {
    overflow: visible;
}

/* Ensure parent containers don't clip dropdowns */
.tab-content {
    overflow: visible;
}

Foldout {
    overflow: visible;
}

Foldout > .unity-foldout__content {
    overflow: visible;
}

.content-container {
    overflow: visible;
}

.section {
    overflow: visible;
}
