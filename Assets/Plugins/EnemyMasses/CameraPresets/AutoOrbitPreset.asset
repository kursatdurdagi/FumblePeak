  presetName: Auto Orbit
  description: "Camera auto-orbits behind the target\u2019s movement direction (Batman
    Arkham, God of War). No manual rotation needed \u2014 very controller-friendly."
  initialZoom: 8
  initialPitch: 25
  initialYaw: 0
  moveSpeed: 20
  fastMoveSpeed: 40
  moveAcceleration: 8
  moveDeceleration: 12
  smoothMovement: 1
